Options -Indexes +FollowSymLinks
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # 1. SSL (HTTPS) & Non-WWW Canonicalization (301 Permanent Redirects)
  # ----------------------------------------------------------------------
  # Force HTTP to HTTPS 301 Redirect
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Force www.coreunitysolutions.com to coreunitysolutions.com 301 Redirect
  RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # ----------------------------------------------------------------------
  # 2. Static HTML Route Rewriting
  # ----------------------------------------------------------------------
  # If request matches existing file or folder, serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Clean URL rewriting for static html export
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>
